nsim = 40
files <- list.files(
"C:/Users/01459189/OneDrive/phd/hpc - mixed/RAW26/ss",
pattern = "ss_.*\\.Rdata$",
full.names = TRUE
)
parse_settings <- function(path) {
name <- basename(path)
dataset <- sub("^ss_(d_mix[0-9]+)_.*", "\\1", name)
strata  <- as.numeric(sub(".*_([0-9]+)strata_.*", "\\1", name))
N       <- as.numeric(sub(".*_([0-9]+)n_.*", "\\1", name))
list(
dataset = dataset,
strata = strata,
N = N
)
}
res_list <- list()
base_out <- "C:/Users/01459189/OneDrive/phd/hpc - mixed/WIP26/ss/"
for (f in files) {
load(f)  # loads object called `store`
fname <- tools::file_path_sans_ext(basename(f))
settings <- parse_settings(fname)
# ---- extract cleanly ----
n      <- store[[2]]
n_ss   <- sapply(n, sum)
strata <- store[[3]]
deff     <- store[[5]]
if (settings$dataset %in% c("d_mix5", "d_mix6")) {
deff_y <- matrix(unlist(store[[6]]), ncol = 2, byrow = TRUE)
deff_b <- matrix(unlist(store[[7]]), ncol = 2, byrow = TRUE)
deff_g <- matrix(NA, nrow = nsim, ncol = 2)
cv_y <- matrix(unlist(store[[9]]), ncol = 2, byrow = TRUE)
cv_b <- matrix(unlist(store[[10]]), ncol = 2, byrow = TRUE)
cv_g <- matrix(NA, nrow = nsim, ncol = 2)
}
if (settings$dataset %in% c("d_mix0")) {
deff_y <- matrix(unlist(store[[6]]), ncol = 2, byrow = TRUE)
deff_b <- matrix(NA, nrow = nsim, ncol = 2)
deff_g <- matrix(NA, nrow = nsim, ncol = 2)
cv_y <- matrix(unlist(store[[9]]), ncol = 2, byrow = TRUE)
cv_b <- matrix(NA, nrow = nsim, ncol = 2)
cv_g <- matrix(NA, nrow = nsim, ncol = 2)
}
if (settings$dataset %in% c("d_mix1", "d_mix2", "d_mix3", "d_mix4")) {
deff_y <- cbind(unlist(store[[6]]), NA)
deff_b <- cbind(unlist(store[[7]]), NA)
deff_g <- cbind(unlist(store[[8]]), NA)
cv_y <- cbind(unlist(store[[9]]), NA)
cv_b <- cbind(unlist(store[[10]]), NA)
cv_g <- cbind(unlist(store[[11]]), NA)
}
if (ncol(deff_y) == 1) deff_y <- cbind(deff_y, NA)
if (ncol(deff_b) == 1) deff_b <- cbind(deff_b, NA)
if (ncol(deff_g) == 1) deff_g <- cbind(deff_g, NA)
if (ncol(cv_y) == 1) cv_y <- cbind(cv_y, NA)
if (ncol(cv_b) == 1) cv_b <- cbind(cv_b, NA)
if (ncol(cv_g) == 1) cv_g <- cbind(cv_g, NA)
time   <- store[[4]]
#deff_log <- store[[6]]
# ---- save side objects ----
save(n, file = paste0(base_out, fname, "_n.RData"))
#save(deff_log, file = paste0(base_out, fname, "_deff_log.RData"))
save(strata, file = paste0(base_out, fname, "_strata.RData"))
# save(deff_y, file = paste0(base_out, fname, "_deff_y.RData"))
#save(deff_b, file = paste0(base_out, fname, "_deff_b.RData"))
#save(deff_g, file = paste0(base_out, fname, "_deff_g.RData"))
