#save(cv_b, file = paste0(base_out, fname, "_cv_b.RData"))
#save(cv_g, file = paste0(base_out, fname, "_cv_g.RData"))
# ---- clean tibble row ----
res_tmp <- tibble(
method  = "ss",
dataset = settings$dataset,
strata  = settings$strata,
strata_real = store[[13]],
n = n_ss,
N       = settings$N,
deff   = unname(as.vector(deff)),
time    = unname(as.vector(time)),
## DEFF
deff_y_1 = deff_y[,1],
deff_y_2 = deff_y[,2],
deff_b_1 = deff_b[,1],
deff_b_2 = deff_b[,2],
deff_g_1 = deff_g[,1],
#deff_g_2 = deff_g[,2],
## CV
cv_y_1 = cv_y[,1],
cv_y_2 = cv_y[,2],
cv_b_1 = cv_b[,1],
cv_b_2 = cv_b[,2],
cv_g_1 = cv_g[,1],
#cv_g_2 = cv_g[,2],
run_id  = fname
)
res_list[[fname]] <- res_tmp
rm(store)  # avoid accidental reuse
}
# combine everything
res <- bind_rows(res_list)
save(res, file = paste0(base_out, "ss_all_res.RData"))
