## datasets graphing
library(MASS)
library(mvtnorm)
library(copula)
library(triangle)
library(rebmix)
library(GGally)
library(bindata)
library(FactoMineR)
library(ggthemes)
library(patchwork)
library(ggplot2)
library(haven)
library(cowplot)
setwd("C:/Users/01459189/OneDrive/phd/hpc/mediods/multivar_datasets")
## TB5
load("tb5.RData")
tb5 <- df[2:7]
## GHS
load("ghs_2024.RData")
df$hhinc_pc <- df$totmhinc/df$hholdsz
df <- df[df$fin_reqinc!=9999999,]
ghs <- df[,-4]
## NIDS
load("nids_w5.RData")
nids <- df
## ECD
load("ecd_census_multivariate.RData")
ecd <- df
# Set a global theme with smaller text
theme_set(
theme_light() +
theme(
plot.title = element_text(size = 8.5, family = "serif"),   # overall titles
axis.text = element_text(size = 4, family = "serif"),     # axis tick labels
axis.title = element_text(size = 6.5, family = "serif"),   # axis titles
strip.text = element_text(size = 6.5, family = "serif")     # column/facet labels
))
plot_tb5 <- ggpairs(tb5,
aes(alpha = 0.2),
columnLabels = c("Age", "Domain 1", "Domain 2", "Domain 3", "Domain 4", "Domain 5"),
lower = list(continuous = wrap("points", alpha=0.2, size=0.3)),
upper = list(continuous = wrap("cor", size = 2)),
diag = list(continuous = wrap("densityDiag", alpha=0.5, size=0.4))) +
labs(title = "TB5")
plot_tb5
plot_nids <- ggpairs(nids,
aes(alpha = 0.2),
columnLabels = c("Household income", "Food expenditure"),
lower = list(continuous = wrap("points", alpha=0.2, size=0.3)),
upper = list(continuous = wrap("cor", size = 2)),
diag = list(continuous = wrap("densityDiag", alpha=0.5, size=0.4))) +
labs(title = "NIDS")
plot_nids
plot_ghs <- ggpairs(ghs,
aes(alpha = 0.2),
columnLabels = c("Hh. head age", "Net hh. income", "Household size", "Hh. income pc"),
lower = list(continuous = wrap("points", alpha=0.2, size=0.3)),
upper = list(continuous = wrap("cor", size = 2)),
diag = list(continuous = wrap("densityDiag", alpha=0.5, size=0.4))) +
labs(title = "GHS")
plot_ghs
plot_ecd <- ggpairs(ecd,
aes(alpha = 0.2),
columnLabels = c("Fees", "Reg. learners", "Facility age"),
lower = list(continuous = wrap("points", alpha=0.2, size=0.3)),
upper = list(continuous = wrap("cor", size = 2)),
diag = list(continuous = wrap("densityDiag", alpha=0.5, size=0.4))) +
labs(title = "ECD")
plot_ecd
#-----------------------------
# Combine into multi-panel figures
#-----------------------------
p1 <- plot_grid(
ggmatrix_gtable(plot_tb5),
ggmatrix_gtable(plot_nids),
ggmatrix_gtable(plot_ghs),
ggmatrix_gtable(plot_ecd),
nrow = 2)
p1
ggsave("appdata.pdf", plot = p1, width = 7, height = 7, units = "in", dpi = 300)
